# Bos = ayni origin: istekler vite proxy'sinden gecer (vite.config.ts /api, /ws).
# LAN'dan (telefon) acildiginda 'localhost' telefonun kendisi olurdu; proxy bunu cozer
# ve cerez/CORS de same-origin kalir. Backend'e DOGRUDAN vurmak icin tam URL yaz.
VITE_API_URL=
VITE_WS_URL=

VITE_GOOGLE_CLIENT_ID=

VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
