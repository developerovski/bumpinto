# Bos = ayni origin: istekler vite proxy'sinden gecer (vite.config.ts /api, /ws).
# LAN'dan (telefon) acildiginda 'localhost' telefonun kendisi olurdu; proxy bunu cozer
# ve cerez/CORS de same-origin kalir. Backend'e DOGRUDAN vurmak icin tam URL yaz.
VITE_API_URL=
VITE_WS_URL=

# OAuth Web client id (herkese acik, sir degil). Gercek deger .env.development.local'da.
VITE_GOOGLE_CLIENT_ID=

# Harita motoru /api/config'ten gelir (varsayilan maplibre, anahtarsiz). YALNIZ MAP_ENGINE=google
# provasinda VITE_GOOGLE_MAPS_KEY ve VITE_GOOGLE_MAPS_MAP_ID gerekir; .env.development.local'a yaz.

VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
VITE_CLARITY_ID=
VITE_GA4_ID=
