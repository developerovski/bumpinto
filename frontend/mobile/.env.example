# BumpInto mobil — ornek ortam degiskenleri.
# EXPO_PUBLIC_* degerleri SIR DEGILDIR: istemci paketine gomulur (I-3/plan44: GitHub "variables").

EXPO_PUBLIC_API_URL=http://localhost:8060
EXPO_PUBLIC_WEB_BASE=https://bumpinto.app

# Google girisi — UC AYRI OAuth client gerekir, ama backend YALNIZ web client'i bilir.
#
#   Web client    -> asagidaki WEB_CLIENT_ID. Kutuphane id_token'i BU client adina ister,
#                    yani `aud` web ve mobilde ayni; backend'in GOOGLE_CLIENT_ID'si de budur.
#   iOS client    -> yalnizca yerel SDK'nin OAuth devri icin. Bundle ID: app.bumpinto.mobile
#   Android client-> hicbir kodda gecmez; package app.bumpinto.mobile + SHA-1 ile kayitli olmali.
#                    Her imza anahtari icin AYRI client: yerel debug, EAS build, Play App Signing.
#
# IOS_URL_SCHEME = iOS client ID'sinin TERSI:
#   1234-abc.apps.googleusercontent.com -> com.googleusercontent.apps.1234-abc
# Bosken prebuild yine calisir ama iOS'ta giristen uygulamaya DONUS olmaz.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# GOOGLE_MAPS_* ANAHTARI YOK: mobil Google Maps kullanmaz (MAP_ENGINE=maplibre).
# Harita secici M-7'de @maplibre/maplibre-react-native ile gelir — anahtarsiz calisir.
